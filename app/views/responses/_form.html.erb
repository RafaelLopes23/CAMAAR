<%= form_with(model: response) do |form| %>
  <% if response.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(response.errors.count, "error") %> prohibited this response from being saved:</h2>

      <ul>
        <% response.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :form_id, "Formulário", style: "display: block" %>
    <%= form.collection_select :form_id, ::Form.all, :id, :title, prompt: "Selecione o Formulário" %>
  </div>
  <%= form.hidden_field :user_id, value: form.object.user_id || ::User.first&.id || ::User.create!(name: "Participante", email: "part@example.com").id %>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.textarea :content %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
