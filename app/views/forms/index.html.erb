<% content_for :title, "Formulários Disponíveis" %>

<div class="container mx-auto p-6">
  <% if notice %>
    <div class="mb-4 p-4 bg-green-100 text-green-700 rounded-lg border border-green-300">
      <%= notice %>
    </div>
  <% end %>

  <% if alert %>
    <div class="mb-4 p-4 bg-red-100 text-red-700 rounded-lg border border-red-300">
      <%= alert %>
    </div>
  <% end %>

    <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold">Formulários Disponíveis</h1>
    <% begin
         show_new = policy(Template).new?
       rescue
         show_new = false
       end %>
    <% if show_new %>
      <%= link_to "Novo Formulário", new_form_path, class: "px-4 py-2 bg-blue-500 text-white rounded" %>
    <% end %>
  </div>

  <% available_forms = @forms.select { |f| f.responses.where(user: current_user).empty? } %>

  <% if available_forms.empty? %>
    <div class="p-6 bg-gray-50 rounded-lg text-center text-gray-600">
      Você não possui formulários pendentes
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse border border-gray-300 rounded-lg shadow">
        <thead class="bg-blue-500 text-white">
          <tr>
            <th class="border border-gray-300 px-6 py-3 text-left font-semibold">Título</th>
            <th class="border border-gray-300 px-6 py-3 text-left font-semibold">Template</th>
            <th class="border border-gray-300 px-6 py-3 text-left font-semibold">Disponibilizado em</th>
            <th class="border border-gray-300 px-6 py-3 text-center font-semibold">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% available_forms.each do |form| %>
            <tr class="hover:bg-gray-50">
              <td class="border border-gray-300 px-6 py-3"><%= form.title %></td>
              <td class="border border-gray-300 px-6 py-3"><%= form.template&.name || '—' %></td>
              <td class="border border-gray-300 px-6 py-3 text-sm text-gray-600"><%= l(form.created_at, format: :short) if form.created_at %></td>
              <td class="border border-gray-300 px-6 py-3 text-center">
                <div class="flex justify-center gap-2">
                  <%= link_to "Responder", new_response_path(form_id: form.id), class: "px-3 py-1 bg-green-100 text-green-700 rounded hover:bg-green-200" %>
                  <%= link_to "Visualizar", form_path(form), class: "px-3 py-1 bg-blue-100 text-blue-700 rounded hover:bg-blue-200" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
