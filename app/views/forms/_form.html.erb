<%= form_with(model: form) do |f| %>
  <% if form.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(form.errors.count, "error") %> prohibited this form from being saved:</h2>
      <ul>
        <% form.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Turma", style: "display: block" %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :template_id, "Template", style: "display: block" %>
    <%= f.collection_select :template_id, ::Template.all, :id, :name, prompt: "Selecione" %>
  </div>

  <div>
    <%= f.submit %>
  </div>
<% end %>
