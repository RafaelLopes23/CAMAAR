<% content_for :title, @template.name %>

<div class="container mx-auto p-6">
  <% if notice %>
    <div class="mb-6 p-4 bg-green-100 text-green-700 rounded-lg border border-green-300">
      <%= notice %>
    </div>
  <% end %>

  <div class="max-w-2xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold"><%= @template.name %></h1>
      <%= link_to "Voltar", templates_path, class: "text-gray-600 hover:text-gray-800" %>
    </div>

    <div class="bg-white rounded-lg shadow-md p-8 mb-6">
      <div class="mb-6">
        <h2 class="text-lg font-semibold text-gray-700 mb-2">Descrição</h2>
        <p class="text-gray-600"><%= @template.description || "Sem descrição" %></p>
      </div>

      <div class="mb-6 pb-6 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-700 mb-2">Informações</h2>
        <p class="text-gray-600">
          <strong>Criado em:</strong> 
          <% if @template.created_at %>
            <%= l(@template.created_at, format: :short) %>
          <% end %>
        </p>
        <p class="text-gray-600">
          <strong>Formulários vinculados:</strong> 
          <%= @template.forms.count %>
        </p>
      </div>

      <div class="flex gap-3">
        <%= link_to "Editar", edit_template_path(@template), class: "px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition" %>
        
        <% if @template.forms.any? %>
          <button disabled class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg cursor-not-allowed" title="Não é possível deletar templates com formulários">
            Excluir (indisponível)
          </button>
        <% else %>
          <%= link_to "Excluir", template_path(@template), method: :delete, data: { confirm: "Tem certeza?" }, class: "px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
