<% content_for :title, "Meus Templates" %>

<div class="container mx-auto p-6">
  <% if notice %>
    <div class="mb-4 p-4 bg-green-100 text-green-700 rounded-lg border border-green-300">
      <%= notice %>
    </div>
  <% end %>

  <% if alert %>
    <div class="mb-4 p-4 bg-red-100 text-red-700 rounded-lg border border-red-300">
      <%= alert %>
    </div>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Meus Templates</h1>
    <%= link_to "Novo Template", new_template_path, class: "px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition" %>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full border-collapse border border-gray-300 rounded-lg shadow">
      <thead class="bg-blue-500 text-white">
        <tr>
          <th class="border border-gray-300 px-6 py-3 text-left font-semibold">Nome</th>
          <th class="border border-gray-300 px-6 py-3 text-left font-semibold">Descrição</th>
          <th class="border border-gray-300 px-6 py-3 text-center font-semibold">Formulários</th>
          <th class="border border-gray-300 px-6 py-3 text-left font-semibold">Criado em</th>
          <th class="border border-gray-300 px-6 py-3 text-center font-semibold">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if @templates.empty? %>
          <tr>
            <td colspan="5" class="border border-gray-300 px-6 py-8 text-center text-gray-600">
              Nenhum template encontrado. Crie um novo template.
            </td>
          </tr>
        <% else %>
          <% @templates.each do |template| %>
            <tr class="hover:bg-gray-50 transition">
              <td class="border border-gray-300 px-6 py-3 font-medium text-gray-800"><%= template.name %></td>
              <td class="border border-gray-300 px-6 py-3 text-gray-600"><%= template.description || "—" %></td>
              <td class="border border-gray-300 px-6 py-3 text-center">
                <% if template.forms.any? %>
                  <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded text-sm font-medium">
                    <%= template.forms.count %>
                  </span>
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
              <td class="border border-gray-300 px-6 py-3 text-gray-500 text-sm">
                <% if template.created_at %>
                  <%= l(template.created_at, format: :short) %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="border border-gray-300 px-6 py-3 text-center">
                <div class="flex justify-center gap-2">
                  <%= link_to "Visualizar", template, class: "px-3 py-1 bg-blue-100 text-blue-700 rounded hover:bg-blue-200 transition text-sm" %>
                  <%= link_to "Editar", edit_template_path(template), class: "px-3 py-1 bg-yellow-100 text-yellow-700 rounded hover:bg-yellow-200 transition text-sm" %>
                  
                    <%= link_to "Excluir", template, method: :delete, data: { confirm: "Tem certeza?" }, class: "px-3 py-1 bg-red-100 text-red-700 rounded hover:bg-red-200 transition text-sm" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
